# `.env` está en .gitignore: nunca se versiona. Solo valores de ejemplo, sin secretos.
# Ojo: toda variable VITE_* queda visible en el navegador. Nunca pongas claves aquí.

# URL base del API en producción (Render), sin barra final. Se define en Netlify.
# En desarrollo déjala vacía: las peticiones a /api pasan por el proxy de Vite.
VITE_API_BASE=

# Solo desarrollo: destino del proxy de Vite (lo lee vite.config.ts, no llega al navegador).
EUROFIBO_API=http://127.0.0.1:8484
